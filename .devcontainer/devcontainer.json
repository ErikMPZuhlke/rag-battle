{
  "name": "RAG Battle Royale",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/powershell:2": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "RAG API", "onAutoForward": "notify" }
  },
  "remoteEnv": {
    "GROQ_API_KEY": "${localEnv:GROQ_API_KEY}"
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && bash .devcontainer/setup-oh-my-posh.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-vscode.powershell"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "pwsh"
          }
        }
      }
    }
  }
}
