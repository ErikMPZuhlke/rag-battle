# Groq API key (generation + LLM-as-judge). Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Chat model used for answer generation and (by the evaluator) as judge
GROQ_MODEL=openai/gpt-oss-20b

# Chroma persistence directory (embeddings run locally, no key needed)
CHROMA_PERSIST_DIR=.chroma
KNOWLEDGE_BASE_DIR=data/knowledge-base

# Baseline retrieval setting
TOP_K=5

# Per-question resource budget enforced by app/budget.py
MAX_LLM_CALLS=3
MAX_RETRIEVALS=10
MAX_INPUT_TOKENS=4000

# Used by the organizer's docker-compose.eval.yml / evaluator, not required for local dev
TEAM_NAME=team-01
PORT=8000
