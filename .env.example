# Groq API key (generation + LLM-as-judge). Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Chat model used for answer generation and (by the evaluator) as judge
GROQ_MODEL=openai/gpt-oss-20b

# Chroma persistence directory (embeddings run locally, no key needed)
CHROMA_PERSIST_DIR=.chroma
KNOWLEDGE_BASE_DIR=data/knowledge-base

# Baseline retrieval setting
TOP_K=5

# Per-question resource budget enforced by app/core/budget.py
MAX_LLM_CALLS=3
MAX_RETRIEVALS=10
MAX_INPUT_TOKENS=4000

# Used by docker-compose.eval.yml and the rag-eval-report skill's evaluator
# (identifies your team in the submitted results and on the leaderboard)
TEAM_NAME=team-01
PORT=8000

# Leaderboard submission channel (organizers provide these at the start of the
# event; see leaderboard/participant/README.md). Only used by
# evaluation.submit / evaluation.evaluator for hidden runs.
LEADERBOARD_SUBMIT_URL=https://<public-address-provided-by-organizers>
LEADERBOARD_SUBMIT_TOKEN=<shared-secret-provided-by-organizers>
