{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run API",
      "dependsOn": ["Start API server", "Open API docs"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Start API server",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          { "regexp": ".", "file": 1, "line": 1, "column": 1, "message": 1 }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process|Will watch for changes",
          "endsPattern": "Uvicorn running on|Application startup complete"
        }
      }
    },
    {
      "label": "Run Streamlit UI",
      "dependsOn": ["Start Streamlit UI server", "Open Streamlit UI"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Start Streamlit UI server",
      "type": "shell",
      "command": "streamlit run app/ui/streamlit_app.py",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          { "regexp": ".", "file": 1, "line": 1, "column": 1, "message": 1 }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "You can now view your Streamlit app",
          "endsPattern": "Local URL:"
        }
      }
    },
    {
      "label": "Open Streamlit UI",
      "type": "shell",
      "command": "echo ${input:openStreamlitUI}",
      "problemMatcher": []
    },
    {
      "label": "Open API docs",
      "type": "shell",
      "command": "echo ${input:openSwaggerDocs}",
      "problemMatcher": []
    },
    {
      "label": "Ingest corpus",
      "type": "shell",
      "command": "python -m app.services.ingest",
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "pytest tests/unit -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run integration tests",
      "type": "shell",
      "command": "pytest tests/integration -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Streamlit UI tests",
      "type": "shell",
      "command": "pytest tests/streamlit -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run e2e tests",
      "type": "shell",
      "command": "pytest tests/e2e -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run ALL tests",
      "dependsOn": ["Run unit tests", "Run integration tests", "Run Streamlit UI tests", "Run e2e tests"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openSwaggerDocs",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:8000/docs"
    },
    {
      "id": "openStreamlitUI",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:8501"
    }
  ]
}
